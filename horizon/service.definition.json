{
	"org": "$HZN_ORG_ID",
	"label": "$SERVICE_NAME for $ARCH",
	"description": "A service to deploy Grafana with Open Horizon",
	"documentation": "https://grafana.com/docs/grafana/latest/",
	"url": "$SERVICE_NAME",
	"version": "$SERVICE_VERSION",
	"arch": "$ARCH",
	"public": true,
	"sharable": "singleton",
	"requiredServices": [],
	"userInput": [
		{
			"name": "MY_TIME_ZONE",
			"label": "User time zone",
			"type": "string",
			"defaultValue": "$MY_TIME_ZONE"
		}
	],
	"deployment": {
		"services": {
			"$SERVICE_NAME": {
				"image": "$DOCKER_IMAGE_BASE:$DOCKER_IMAGE_VERSION",
				"environment": [
					"GF_SERVER_HTTP_PORT=$GRAFANA_CONTAINER_PORT",
					"GF_PATHS_DATA=$GRAFANA_DATA_PATH"
				],
				"ports": [
					{ "HostIP": "$GRAFANA_HOST_IP", "HostPort": "$GRAFANA_HOST_PORT:$GRAFANA_CONTAINER_PORT/tcp" }
				],
				"binds": [
					"$DOCKER_VOLUME_NAME:$GRAFANA_DATA_PATH"
				]
			}
		}
	}
}
